# Public client configuration only. Never place Supabase service-role or other secrets in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Deployment base. "./" is the safe default for GitHub Pages/subdirectory deployments.
VITE_BASE_PATH=./

# Production source maps are disabled for public releases. Use hidden only for a controlled diagnostic build whose maps are not deployed publicly.
# Supported: false | hidden | true | inline
VITE_BUILD_SOURCEMAP=false
